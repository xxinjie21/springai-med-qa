<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.med.qa</groupId>
    <artifactId>springai-med-qa</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>springai-med-qa</name>
    <description>Hospital-grade AI consultation backend (Spring Boot 3 / Spring AI)</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <protobuf-maven-plugin.version>3.1.0</protobuf-maven-plugin.version>
        <protobuf-java.version>4.29.3</protobuf-java.version>
        <jacoco-maven-plugin.version>0.8.13</jacoco-maven-plugin.version>
        <shardingsphere.version>5.5.2</shardingsphere.version>
        <redisson.version>3.45.1</redisson.version>
        <spring-ai.version>1.0.0</spring-ai.version>
        <hutool.version>5.8.37</hutool.version>
        <!--
            SpringDoc OpenAPI 2.8.x is the GA line that supports Spring Boot 3.4 / Spring Framework
            6.2. Earlier 2.5.x releases break at runtime with a NoSuchMethodError on
            ControllerAdviceBean, so 2.8.x is the only safe choice for this stack. The Boot BOM does
            not manage SpringDoc, hence the explicit version.
        -->
        <springdoc.version>2.8.5</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                Spring AI BOM: pins every org.springframework.ai module to one GA version
                (1.0.0, compatible with Spring Boot 3.4.x and Java 17). Only the chat-memory
                client library is pulled in at D12; vector store / model starters arrive later.
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!--
            Spring AOP + AspectJ weaving, backing the declarative @MedAudit audit trail (and, from
            D25 on, the @RateLimit annotation). The official starter brings the proxy infrastructure
            and the SpEL-based target expressions, so no interception, latency measurement or
            annotation scanning is hand-written. Version managed by the Spring Boot BOM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf-java.version}</version>
        </dependency>

        <!-- Transparent MySQL table sharding: med_message_{crc32(session_id) % 16} -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-jdbc</artifactId>
            <version>${shardingsphere.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Required at runtime by ShardingSphere's standalone JDBC metadata repository, and reused
            as an in-memory stand-in for MySQL so sharding routing is verified without middleware.
            Must stay `runtime` (not `test`): narrowing the scope would break ShardingSphere startup.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MyBatis over the ShardingSphere DataSource: transparent med_message sharded CRUD. -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.4</version>
        </dependency>

        <!-- Flyway migrations that create the 16 med_message physical shards (version managed by BOM). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!--
            Spring Data Redis (Lettuce) backing the med:chat:{tenant}:{dept}:{session} message
            cache. Version managed by the Spring Boot BOM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            Spring AI chat-memory client library: provides ChatMemory / ChatMemoryRepository /
            MessageWindowChatMemory (the official, maintained short-term memory) and the
            MessageChatMemoryAdvisor that plugs memory into the ChatClient chain. Version is
            managed by the Spring AI BOM. No autoconfiguration jar is on the classpath, so adding
            it does not require any LLM API key or connection at context startup.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>

        <!--
            Redisson supplies the distributed session lock (RLock with watchdog lease renewal) and,
            from D25 on, the RRateLimiter. No hand-rolled SETNX/Lua locking is written in this
            project. Version pinned to the 3.45.x line, which tracks the same Netty 4.1 baseline as
            the Spring Boot 3.4 BOM.
        -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <!--
            Spring AI Redis vector store starter (RediSearch/Redis Stack). Supplies the official
            RedisVectorStore, so no cosine/L2 math, Top-K heap, LRU eviction or snapshot persistence
            is written by hand. Version managed by the Spring AI BOM. The starter's
            auto-configuration is excluded in application.yml because it eagerly creates the search
            index during context refresh; config/VectorStoreConfig declares the bean lazily instead.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-redis</artifactId>
        </dependency>

        <!--
            Spring AI official RAG advisor: QuestionAnswerAdvisor retrieves scoped documents from the
            vector store and augments the prompt. The advisor reuses the project's MedRetrievalService
            (Top-K, threshold) and MedRetrievalFilters (tenant/dept/patient tag isolation), so no
            retrieval pipeline, similarity scoring or prompt stitching is hand-written. Version is
            managed by the Spring AI BOM (1.0.0, matching the rest of the stack).
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-advisors-vector-store</artifactId>
        </dependency>

        <!--
            Spring AI OpenAI-compatible model starter. Only its embedding side is used here: it
            supplies the official OpenAiEmbeddingModel plus the canonical spring.ai.openai.*
            configuration properties (base-url, api-key, embeddings-path, options.model,
            options.dimensions) and the spring.ai.retry.* backoff policy, so no HTTP client, retry
            loop or token batching is hand-written. Because any OpenAI-compatible gateway exposes
            the same REST contract, the endpoint can be repointed at an on-premise medical model
            purely through configuration. The model auto-configurations are excluded in
            application.yml (they fail fast when no API key is present, which would make the whole
            offline test suite unbootable); config/EmbeddingModelConfig declares the model lazily
            from the very same properties instead.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
            Field desensitization (D24): the @Desensitize annotation delegates masking to the
            maintained Hutool DesensitizedUtil, so no mask patterns are hand-written. Version pinned
            to the 5.8.x GA line; the Spring Boot BOM does not manage Hutool.
        -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!--
            API documentation (D26): SpringDoc OpenAPI generates the OpenAPI 3 description and Swagger
            UI straight from the controllers and DTOs at runtime, so no HTML or doc scaffolding is
            hand-written. The starter pulls in swagger-ui and the webmvc integration; the Boot BOM does
            not manage it, so the version is pinned via the springdoc.version property. All docs are
            derived from annotations + this project's MedOpenApiProperties; no extra middleware.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>${protobuf-maven-plugin.version}</version>
                <configuration>
                    <protocVersion>${protobuf-java.version}</protocVersion>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-protobuf-java</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <configuration>
                    <excludes>
                        <!-- protobuf generated sources are not hand-written code -->
                        <exclude>com/med/qa/proto/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
